<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FAFAFA">

    <Button
        android:id="@+id/btnBackAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Study Resource"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resource Title:"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etResourceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter title (e.g. Lecture 1 Slides)"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resource Link / URL:"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etResourceUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://..."
        android:inputType="textUri"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Description / Notes:"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etResourceDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter optional notes"
        android:inputType="textMultiLine"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category:"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/rbLectures"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lectures"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbLabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Labs"
            android:layout_marginStart="16dp" />

        <RadioButton
            android:id="@+id/rbTasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tasks"
            android:layout_marginStart="16dp" />
    </RadioGroup>

    <Button
        android:id="@+id/btnSaveResource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Resource"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF" />

</LinearLayout>